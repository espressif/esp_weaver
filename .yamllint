---
# yamllint configuration for ESP-Weaver
# Relaxed rules for CI configuration files

extends: default

rules:
  # Trailing spaces should always be removed
  trailing-spaces: enable

  # Line length: relaxed for CI files with long commands
  line-length:
    max: 120
    level: warning

  # Document start: our YAML files are single documents and start
  # directly with content (a profile's first line is `version: 1`).
  document-start: disable

  # Comments indentation: allow flexibility
  comments-indentation: disable

  # Truthy values: allow 'yes', 'no', 'on', 'off' in CI files
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no', 'on', 'off']


  # The device profiles write inline mappings as "{ min: 0, max: 1 }" and
  # align columns with extra spaces; that is deliberate, not sloppiness.
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1
  colons:
    max-spaces-after: -1
  commas:
    max-spaces-after: -1
